# demo runs without access to real DNS. Live mode requires explicit config.
DNS_MODE=demo
LISTEN_ADDRESS=127.0.0.1
HTTP_PORT=8088
DNS_ADMIN_USERNAME=admin
# Required in live mode: unique password, at least 16 characters.
DNS_ADMIN_PASSWORD=
DNS_VIEWER_USERNAME=viewer
DNS_VIEWER_PASSWORD=
# Set true behind an HTTPS reverse proxy.
SESSION_COOKIE_SECURE=false
DNS_WEB_TSIG_SECRET=

# Optional external PostgreSQL (provided separately).
# DATABASE_URL=jdbc:postgresql://postgres:5432/dns_probe
# DATABASE_USERNAME=dns_probe
# DATABASE_PASSWORD=replace-with-generated-password

# Optional DHCP management. Configure both Kea Control Agent endpoints.
DHCP_ENABLED=false
KEA1_API_URL=http://192.0.2.21:8000/
KEA1_API_USERNAME=dns-probe
KEA1_API_PASSWORD=
KEA2_API_URL=http://192.0.2.22:8000/
KEA2_API_USERNAME=dns-probe
KEA2_API_PASSWORD=
